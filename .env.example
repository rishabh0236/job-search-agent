# Copy to .env and fill in. NEVER commit .env.
# Names only in this file — no real values.

# --- Runtime ---
CA_APP_ENV=local
CA_LOG_LEVEL=INFO

# --- Storage ---
# SQLite for local dev. Swap for postgresql+psycopg://user:pass@host/db later;
# the schema is PostgreSQL-compatible.
CA_DATABASE_URL=sqlite:///./data/career_agent.db
CA_DATA_DIR=./data

# --- LLM provider ---
# "stub"      -> deterministic offline provider (no network, used by tests)
# "anthropic" -> real Claude calls, requires CA_ANTHROPIC_API_KEY
CA_LLM_PROVIDER=stub
CA_ANTHROPIC_API_KEY=
CA_LLM_MODEL=claude-opus-5
CA_LLM_MAX_RETRIES=2
CA_LLM_TIMEOUT_SECONDS=120

# --- Job sources ---
# All of these are public, official, no-login APIs — never scraping. Leave
# everything empty to use only the local fixture source.

# Comma-separated Greenhouse board tokens (the slug in boards.greenhouse.io/<token>).
CA_GREENHOUSE_BOARDS=
# Comma-separated Lever site slugs (the slug in jobs.lever.co/<slug>).
CA_LEVER_SITES=
# Comma-separated Ashby job board names (the slug in jobs.ashbyhq.com/<name>).
CA_ASHBY_BOARDS=
# Comma-separated SmartRecruiters company identifiers
# (the slug in jobs.smartrecruiters.com/<id>).
CA_SMARTRECRUITERS_COMPANIES=

# Adzuna: aggregator API, free self-serve key from https://developer.adzuna.com
# (no partner review). Both must be set to activate it.
CA_ADZUNA_APP_ID=
CA_ADZUNA_APP_KEY=
# Country code Adzuna should search — e.g. "in", "gb", "us".
CA_ADZUNA_COUNTRY=in

# Arbeitnow: aggregator API, no key needed at all — off by default so a
# discovery run never silently reaches a third party until you opt in.
CA_ARBEITNOW_ENABLED=false

# Comma-separated company career page URLs, read via their embedded schema.org
# JobPosting structured data (the same markup Google/Bing job search consumes).
# robots.txt is checked and honoured for every request. Not for LinkedIn/Naukri/
# Wellfound — those require login and have no such public structured data feed.
CA_CAREER_PAGES=

# --- LaTeX ---
# Path to the tectonic binary (installed by scripts/bootstrap.sh into .tooling/).
CA_LATEX_ENGINE=tectonic
CA_LATEX_BIN=.tooling/bin/tectonic
CA_LATEX_TIMEOUT_SECONDS=120

# --- Safety switches ---
# Master kill-switch for any browser automation that could submit an application.
# Submission additionally always requires an explicit per-application user approval.
CA_ALLOW_BROWSER_SUBMIT=false
